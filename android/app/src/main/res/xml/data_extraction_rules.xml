<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splits backup into cloud backup and device-to-device transfer.
     allowBackup="false" only covers the first, so exclude everything here too:
     the cache holds a copy of the profile and the credentials are ciphertext
     bound to this device's keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
